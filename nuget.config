<?xml version="1.0" encoding="utf-8"?>
<!--
  本仓库离线编译约束（配合 README「离线编译」一节）：

  本解决方案【零外部 NuGet 包】——五个工程只依赖 .NET 8 SDK 自带的
  基础类库与 Windows Desktop 目标包（随 VS「.NET 桌面开发」工作负载安装），
  不引用任何第三方 NuGet 包。因此这里显式清空全部包源：
    · 任何环境下 dotnet restore / build 都不会发起网络请求，可完全离线编译；
    · 若未来有人加入 PackageReference，还原会立即失败，
      提示其改为「vendor DLL」方式：把 DLL 放入 libs\ 目录用 HintPath 引用，
      而不是悄悄引入联网还原的依赖。

  确需引入第三方包时的标准做法（二选一）：
    1. 下载 DLL 放入 libs\<包名>\<版本>\ 并以 <Reference><HintPath> 引用；
    2. 临时在本文件加入所需源，编译后将包从全局缓存拷入 libs\ 再移除该源。
-->
<configuration>
  <packageSources>
    <!-- 禁用所有 NuGet 包源（含机器级与全局配置中的源），保证离线编译。 -->
    <clear />
  </packageSources>
</configuration>
