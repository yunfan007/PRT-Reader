<UserControl x:Class="Prt.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Prt.App.Views"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 查找 / 替换条（默认隐藏，Ctrl+F / Ctrl+H 唤出） -->
        <Border x:Name="FindBar"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{DynamicResource App.PanelBg}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="查找" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.SubtleText}" Margin="0,0,8,0" />
                <TextBox x:Name="FindBox" Width="190" VerticalAlignment="Center" />
                <TextBlock x:Name="ReplaceLabel" Text="替换" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.SubtleText}" Margin="16,0,8,0" />
                <TextBox x:Name="ReplaceBox" Width="190" VerticalAlignment="Center" />
                <CheckBox x:Name="MatchCaseBox" Content="区分大小写" VerticalAlignment="Center" Margin="16,0,10,0"
                          Foreground="{DynamicResource App.Text}" />
                <Button Content="下一个" Click="OnFindNextClick" Margin="0,0,6,0" />
                <Button x:Name="ReplaceButton" Content="替换" Click="OnReplaceClick" Margin="0,0,6,0" />
                <Button x:Name="ReplaceAllButton" Content="全部替换" Click="OnReplaceAllClick" Margin="0,0,6,0" />
                <Button Content="关闭" Click="OnCloseFindClick" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Editor"
                     Grid.Column="0"
                     Style="{StaticResource Prt.EditorTextBox}"
                     SpellCheck.IsEnabled="False"
                     UndoLimit="500" />

            <GridSplitter x:Name="Splitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource Prt.Splitter}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <!-- 虚拟预览（M2a）：只读的块列表阅读器——每个顶层块是一块独立元素，
                 虚拟化面板只实例化视口内的块，滚动大文档不再整篇参与布局。
                 点击块定位源码；右键提供插入 / 删除块（就地改字回写已按《虚拟化改造方案》移除）。 -->
            <Grid Grid.Column="2">
                <views:VirtualPreview x:Name="Preview" />

                <!-- 渐进渲染进度：解析期间显示于预览顶部，完成后隐藏。 -->
                <ProgressBar x:Name="RenderProgress"
                             Height="3"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Stretch"
                             Minimum="0"
                             Maximum="1"
                             Visibility="Collapsed"
                             Focusable="False"
                             IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
