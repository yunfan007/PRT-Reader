<Window x:Class="Prt.App.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Prt.App.Theming"
        Title="{loc:Loc print.title}"
        Width="940"
        Height="740"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontSize="13">

    <DockPanel>

        <!-- ── 纸张与选项 ── -->
        <Border DockPanel.Dock="Top"
                Padding="14,10"
                Background="{DynamicResource App.PanelBg}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc print.paper}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource App.SubtleText}" />
                <ComboBox x:Name="PaperBox"
                          Width="110"
                          Margin="0,0,18,0"
                          SelectionChanged="OnOptionSelectionChanged">
                    <ComboBoxItem Content="{loc:Loc print.paper.a4}" />
                    <ComboBoxItem Content="{loc:Loc print.paper.a5}" />
                    <ComboBoxItem Content="{loc:Loc print.paper.letter}" />
                </ComboBox>

                <TextBlock Text="{loc:Loc print.orientation}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource App.SubtleText}" />
                <ComboBox x:Name="OrientationBox"
                          Width="110"
                          Margin="0,0,18,0"
                          SelectionChanged="OnOptionSelectionChanged">
                    <ComboBoxItem Content="{loc:Loc print.orientation.portrait}" />
                    <ComboBoxItem Content="{loc:Loc print.orientation.landscape}" />
                </ComboBox>

                <TextBlock Text="{loc:Loc print.margin}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource App.SubtleText}" />
                <ComboBox x:Name="MarginBox"
                          Width="110"
                          Margin="0,0,18,0"
                          SelectionChanged="OnOptionSelectionChanged">
                    <ComboBoxItem Content="{loc:Loc print.margin.narrow}" />
                    <ComboBoxItem Content="{loc:Loc print.margin.normal}" />
                    <ComboBoxItem Content="{loc:Loc print.margin.wide}" />
                </ComboBox>

                <CheckBox x:Name="MonochromeBox"
                          Content="{loc:Loc print.monochrome}"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"
                          Click="OnOptionClick" />
                <CheckBox x:Name="HeaderBox"
                          Content="{loc:Loc print.header}"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"
                          Click="OnOptionClick" />
                <CheckBox x:Name="FooterBox"
                          Content="{loc:Loc print.footer}"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Click="OnOptionClick" />
            </StackPanel>
        </Border>

        <!-- ── 底部：翻页与打印 ── -->
        <Border DockPanel.Dock="Bottom"
                Padding="14,10"
                Background="{DynamicResource App.PanelBg}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PrevButton"
                            Content="{loc:Loc print.prev}"
                            Width="90"
                            Height="30"
                            Click="OnPrevPageClick" />
                    <TextBlock x:Name="PageText"
                               Margin="14,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource App.SubtleText}" />
                    <Button x:Name="NextButton"
                            Content="{loc:Loc print.next}"
                            Width="90"
                            Height="30"
                            Click="OnNextPageClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="MessageText"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               Foreground="{DynamicResource App.SubtleText}" />
                    <Button Content="{loc:Loc print.do}"
                            MinWidth="110"
                            Height="30"
                            Background="{DynamicResource App.Accent}"
                            Foreground="{DynamicResource App.OnAccent}"
                            BorderBrush="{DynamicResource App.Accent}"
                            Click="OnPrintClick" />
                    <Button Content="{loc:Loc common.close}"
                            MinWidth="90"
                            Height="30"
                            Margin="10,0,0,0"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 预览区 ── -->
        <Border Background="{DynamicResource App.WindowBg}" Padding="18">
            <Viewbox Stretch="Uniform">
                <Border BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1">
                    <DocumentPageView x:Name="PageView" Stretch="None" />
                </Border>
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
