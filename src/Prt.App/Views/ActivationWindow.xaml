<Window x:Class="Prt.App.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Prt.App.Theming"
        Title="{loc:Loc activation.title}"
        Width="700"
        SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Prt.App;component/Assets/app.ico"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="{StaticResource Prt.FontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        布局要点（与「信息一长就看不全」的旧版差异）：
        · 正文放进 ScrollViewer，窗口高度上界由 MaxHeight 钳到屏幕工作区（见 .xaml.cs）；
          内容短时窗口照旧自适应高度，内容长时正文内部滚动，四边都不再被裁掉。
        · 「激活码输入 + 结果提示 + 按钮」固定在底部条，不随正文滚动——
          结果提示必须始终可见，否则用户看不到失败原因，会反复点击。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════════════════════ 正文（可滚动） ═════════════════════════ -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="24,20,24,18">

                <!-- 头部：品牌标 + 标题 + 副标题 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="46"
                               Height="46"
                               Fill="{StaticResource Brand.MarkBrush}"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc activation.title}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc activation.subtitle}"
                                   Style="{StaticResource Prt.Hint}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource App.Border}"
                        Margin="0,18,0,18" />

                <!-- ── 当前授权 ── -->
                <TextBlock Text="{loc:Loc activation.section.current}" Style="{StaticResource Prt.SectionTitle}" />
                <Border Style="{StaticResource Prt.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="LevelBadge"
                                    Background="{DynamicResource App.ControlFill}"
                                    BorderBrush="{DynamicResource App.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,5,12,5"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="LevelBadgeText"
                                           Text="{loc:Loc activation.badge.none}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}" />
                            </Border>
                            <TextBlock x:Name="StatusText"
                                       TextWrapping="Wrap"
                                       MaxWidth="470"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1"
                                Background="{DynamicResource App.Border}"
                                Margin="0,12,0,10" />

                        <TextBlock x:Name="StorageText" Style="{StaticResource Prt.Hint}" />
                    </StackPanel>
                </Border>

                <!-- ── 签发明细（旧版 5 段激活码无此段，整块隐藏） ── -->
                <StackPanel x:Name="IssuerSection">
                    <TextBlock Text="{loc:Loc activation.section.issuer}" Style="{StaticResource Prt.SectionTitle}" />
                    <Border Style="{StaticResource Prt.Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{loc:Loc activation.issued.at}"
                                       Style="{StaticResource Prt.FieldLabel}" />
                            <TextBlock x:Name="IssuedAtText" Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource Prt.FieldValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{loc:Loc activation.quota}"
                                       Style="{StaticResource Prt.FieldLabel}" />
                            <TextBlock x:Name="SeatsText" Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource Prt.FieldValue}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{loc:Loc activation.issuer}"
                                       Style="{StaticResource Prt.FieldLabel}" />
                            <TextBlock x:Name="IssuerText" Grid.Row="2" Grid.Column="1"
                                       Style="{StaticResource Prt.FieldValue}" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="{loc:Loc activation.reason}"
                                       Style="{StaticResource Prt.FieldLabel}" />
                            <TextBlock x:Name="ReasonText" Grid.Row="3" Grid.Column="1"
                                       Style="{StaticResource Prt.FieldValue}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── 等级与权益 ── -->
                <TextBlock Text="{loc:Loc activation.section.levels}" Style="{StaticResource Prt.SectionTitle}" />
                <Border Style="{StaticResource Prt.Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,3,0,3">
                            <Run Text="{loc:Loc activation.level.free}" /><Run
                                Text="{loc:Loc activation.level.free.suffix}"
                                Foreground="{DynamicResource App.SubtleText}" />
                        </TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{loc:Loc activation.level.free.desc}"
                                   Foreground="{DynamicResource App.SubtleText}"
                                   TextWrapping="Wrap" Margin="0,3,0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,3,0,3">
                            <Run Text="{loc:Loc activation.level.vip}" /><Run
                                Text="{loc:Loc activation.level.vip.suffix}"
                                Foreground="{DynamicResource App.SubtleText}" />
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{loc:Loc activation.level.vip.desc}"
                                   Foreground="{DynamicResource App.SubtleText}"
                                   TextWrapping="Wrap" Margin="0,3,0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{loc:Loc activation.level.perpetual}"
                                   FontWeight="SemiBold" Margin="0,3,0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{loc:Loc activation.level.perpetual.desc}"
                                   Foreground="{DynamicResource App.SubtleText}"
                                   TextWrapping="Wrap" Margin="0,3,0,3" />
                    </Grid>
                </Border>

                <!-- ── 激活码 ── -->
                <TextBlock Text="{loc:Loc activation.section.code}" Style="{StaticResource Prt.SectionTitle}" />
                <TextBlock Text="{loc:Loc activation.code.hint}"
                           Style="{StaticResource Prt.Hint}"
                           Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Button x:Name="PasteButton"
                            Content="{loc:Loc activation.paste}"
                            FontSize="12"
                            MinHeight="26"
                            Padding="10,0"
                            Click="OnPasteClick" />
                    <Button x:Name="ClearButton"
                            Content="{loc:Loc activation.clear}"
                            FontSize="12"
                            MinHeight="26"
                            Padding="10,0"
                            Margin="6,0,0,0"
                            Click="OnClearClick" />
                </StackPanel>

                <TextBox x:Name="CodeBox"
                         Height="104"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontFamily="{StaticResource Prt.MonoFont}"
                         FontSize="12"
                         Padding="10,8" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════════════ 底部固定条：结果提示 + 按钮 ═════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource App.PanelBg}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel>
                <Border x:Name="MessageBar"
                        Visibility="Collapsed"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MessageIcon"
                                   Style="{StaticResource Prt.IconGlyph}"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Top" />
                        <TextBlock x:Name="MessageText"
                                   TextWrapping="Wrap"
                                   MaxWidth="560"
                                   LineHeight="18" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ActivateButton"
                            Style="{StaticResource Prt.PrimaryButton}"
                            Content="{loc:Loc activation.activate}"
                            MinWidth="104"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OnActivateClick" />
                    <Button Content="{loc:Loc common.close}"
                            MinWidth="88"
                            Height="32"
                            IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
