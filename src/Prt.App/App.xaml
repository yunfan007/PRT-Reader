<Application x:Class="Prt.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        界面配色与控件样式分离：
        · 配色（App.* 画刷）由 AppPalette 在启动时写入 Application.Resources，
          运行时切换「浅色 / 深色界面」只需替换资源值，无需重建界面；
        · 控件样式（含圆角、交互反馈、模板）集中在 Theming/WinUi3Styles.xaml，
          按 WinUI 3 的扁平规范自绘，不依赖系统主题模板；
        · 品牌标记（Brand.MarkBrush 等矢量资源）集中在 Theming/Brand.xaml，
          与窗口图标 Assets/app.ico 同一套几何与配色。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theming/WinUi3Styles.xaml" />
                <ResourceDictionary Source="Theming/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
