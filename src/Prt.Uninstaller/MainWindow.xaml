<Window x:Class="Prt.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 PRT 阅读器"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC">

    <Grid x:Name="Root" DataContext="{Binding ElementName=Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF3E90FF" />
                    <GradientStop Offset="1" Color="#FF0E5BC5" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" Margin="28,0">
                <TextBlock Text="卸载 PRT 阅读器" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="Subtitle" Text="" FontSize="13" Foreground="#FFDCE9FB" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="28,10,28,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource U.Card}">
                    <StackPanel>
                        <TextBlock Text="即将删除" Style="{StaticResource U.SectionTitle}" />
                        <TextBlock x:Name="WhereText" Text="" FontSize="13"
                                   Foreground="#FF1B2733" TextWrapping="Wrap" />
                        <TextBlock Text="· 安装目录下的全部文件（含便携运行时，若有）"
                                   FontSize="13" Foreground="#FF1B2733" Margin="0,6,0,0" />
                        <TextBlock Text="· .prt / .psr / .mdp 文件关联与相关右键菜单项"
                                   FontSize="13" Foreground="#FF1B2733" Margin="0,2" />
                        <TextBlock Text="· 开始菜单项、桌面快捷方式（若由本程序创建）"
                                   FontSize="13" Foreground="#FF1B2733" Margin="0,2" />
                        <TextBlock Text="· 用户级 DOTNET_ROOT（仅当它确实指向本安装的便携运行时）"
                                   FontSize="13" Foreground="#FF1B2733" Margin="0,2" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource U.Card}" Margin="0,12,0,0">
                    <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"
                                           Foreground="#FF5B6B7C" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE6ECF4" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="28,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource U.SecondaryButton}"
                        MinWidth="100" Margin="0,0,10,0" Click="OnCancel" />
                <Button x:Name="UninstallButton" Content="卸载" Style="{StaticResource U.PrimaryButton}"
                        MinWidth="120" Click="OnUninstall" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
