<UserControl x:Class="Prt.Installer.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,0">

            <Grid Margin="0,0,0,16">
                <Ellipse Width="44" Height="44" Fill="#FF1E8E3E" />
                <!--
                    Fill 这里**必须省掉**：写 `Fill="None"` 时，编译期会把 "None" 存成一个
                    SolidColorBrush 的取值，而运行期由 SolidColorBrush.DeserializeFrom 去
                    Brush.Parse("None")——那个内部解析器只认颜色字面量，不认 "None"，
                    直接 "FormatException: 令牌无效"，而失败点落在 Application.DoStartup，
                    界面还一片空白就崩了。Shape 的 Fill 默认就是 null，"None" 与不写等价。
                -->
                <Path Data="M 14,23 L 20,29 L 31,17" Stroke="White" StrokeThickness="3"
                      StrokeLineJoin="Round" />
            </Grid>

            <TextBlock x:Name="TitleText" Text="安装完成" Style="{StaticResource I.Title}" />
            <TextBlock x:Name="SummaryText" Text="" Style="{StaticResource I.Subtitle}" Margin="0,8,0,0" />

            <Border x:Name="RebootBanner" Style="{StaticResource I.Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="装了便携运行时，需要刷新一次外壳" Style="{StaticResource I.SectionTitle}" />
                    <TextBlock Text="本次把便携 .NET 运行时写进了用户级 DOTNET_ROOT。要让「双击文件」直接用到它，"
                               Style="{StaticResource I.Subtitle}" />
                    <TextBlock Text="请注销后重新登录（或重启资源管理器）。在此之前，从开始菜单 / 桌面快捷方式启动不受影响。"
                               Style="{StaticResource I.Subtitle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource I.Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="接下来可以做这些" Style="{StaticResource I.SectionTitle}" />
                    <TextBlock Text="· 双击任意 .prt / .psr / .mdp 文件，即可用可视化模式打开"
                               Foreground="#FF1B2733" FontSize="13" Margin="0,2" />
                    <TextBlock Text="· 从开始菜单或桌面快捷方式启动阅读器"
                               Foreground="#FF1B2733" FontSize="13" Margin="0,2" />
                    <TextBlock Text="· 需要卸载时：开始菜单 → 卸载 PRT 阅读器，或运行安装目录下的 uninstall.exe"
                               Foreground="#FF1B2733" FontSize="13" Margin="0,2" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
